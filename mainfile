}

const inputStyle = (C) => ({
  width: "100%", background: C.panel2, border: `1px solid ${C.line}`, borderRadius: 10,
  padding: "11px 12px", color: C.text, fontSize: 14, fontFamily: "inherit",
});

function TaskSheet({ task, C, onSave, onDelete, onClose }) {
  const [d, setD] = useState(task);
  useEffect(() => setD(task), [task]);
  if (!d) return null;
  const set = (k, v) => setD((x) => ({ ...x, [k]: v }));
  const valid = d.name.trim() && d.days.length &&
    (d.anytime ? d.minutes > 0 : toMin(d.end) > toMin(d.start));

  return (
    <Sheet open={!!task} onClose={onClose} title={task && task.name ? "Edit session" : "New session"} C={C}>
      <Field label="What is it" C={C}>
        <input value={d.name} onChange={(e) => set("name", e.target.value)}
          placeholder="Maths — quadratics" style={inputStyle(C)} />
      </Field>
      <Toggle C={C} on={d.anytime} color={CATEGORIES.Focus} onClick={() => set("anytime", !d.anytime)}
        label="No fixed slot — fit it in anywhere that day" />
      {d.anytime ? (
        <Field label="How long" C={C}>
          <div style={{ display: "flex", gap: 6, marginBottom: 10, flexWrap: "wrap" }}>
            {[25, 50, 60, 75].map((m) => (
              <Chip key={m} active={d.minutes === m} color={XP_C} onClick={() => set("minutes", m)} C={C} small>
                {m} min
              </Chip>
            ))}
          </div>
          <input type="number" min="1" value={d.minutes}
            onChange={(e) => set("minutes", Math.max(0, parseInt(e.target.value || "0", 10)))}
            style={inputStyle(C)} />
        </Field>
      ) : (
        <div style={{ display: "flex", gap: 11 }}>
          <Field label="Start" C={C}>
            <input type="time" value={d.start} onChange={(e) => set("start", e.target.value)} style={inputStyle(C)} />
          </Field>
          <Field label="End" C={C}>
            <input type="time" value={d.end} onChange={(e) => set("end", e.target.value)} style={inputStyle(C)} />
          </Field>
        </div>
      )}
      <Field label="Category" C={C}>
        <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
          {CAT_KEYS.map((c) => (
            <Chip key={c} active={d.category === c} color={CATEGORIES[c]} onClick={() => set("category", c)} C={C} small>{c}</Chip>
          ))}
        </div>
      </Field>
      <Field label="Effort" C={C}>
        <div style={{ display: "flex", gap: 6 }}>
          {DIFF_KEYS.map((k) => (
            <Chip key={k} active={d.difficulty === k} color={XP_C} onClick={() => set("difficulty", k)} C={C} small>
              {k} · {DIFFICULTY[k]} XP
            </Chip>
          ))}
        </div>
      </Field>
      <Field label="Repeats on" C={C}>
        <DayPicker days={d.days} onChange={(v) => set("days", v)} C={C} />
      </Field>
      <Toggle C={C} on={d.must} color={EMBER} onClick={() => set("must", !d.must)}
        label="Non-negotiable — this one happens even on a bad day" />
      <Toggle C={C} on={d.optional} color={ICE} onClick={() => set("optional", !d.optional)}
        label={`Optional — never counts as a miss, and pays +${EXTRA_BONUS} bonus when cleared`} last />

      <div style={{ display: "flex", gap: 9 }}>
        {task && task.name && (
          <button onClick={() => onDelete(d.id)} style={{
            background: C.panel2, border: `1px solid ${C.line}`, color: EMBER,
            borderRadius: 11, padding: "12px 15px", cursor: "pointer",
          }}><Trash2 size={16} /></button>
        )}
        <button disabled={!valid} onClick={() => onSave({ ...d, name: d.name.trim() })} style={{
          flex: 1, background: valid ? XP_C : C.panel2, color: valid ? "#1A1206" : C.faint,
          border: "none", borderRadius: 11, padding: 13, fontWeight: 700, fontSize: 14,
          cursor: valid ? "pointer" : "default",
        }}>Save session</button>
      </div>
    </Sheet>
  );
}

function HabitSheet({ habit, C, onSave, onDelete, onClose }) {
  const [d, setD] = useState(habit);
