      }}>
        <span className={done ? "apex-pop" : ""} style={{
          width: 25, height: 25, borderRadius: 8, flexShrink: 0, display: "grid", placeItems: "center",
          background: done ? col : "transparent", border: `2px solid ${done ? col : C.line}`,
          color: "#0F1420",
        }}>{done && <Check size={15} strokeWidth={3.4} />}</span>
        <span style={{ flex: 1, minWidth: 0 }}>
          <span style={{
            display: "block", fontSize: 14.5, fontWeight: 600, color: C.text,
            textDecoration: done ? "line-through" : "none", opacity: done ? .55 : 1,
            overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap",
          }}>{t.name || "Untitled session"}</span>
          <span style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 3, fontSize: 11.5, color: C.dim }}>
            <Clock size={11} /> {t.anytime ? `${t.minutes} min, any time` : `${fmtTime(t.start)}–${fmtTime(t.end)}`}
            <span style={{ color: col }}>{t.category}</span>
