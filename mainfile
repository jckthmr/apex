        <div style={{ display: "flex", alignItems: "center", gap: 11 }}>
          <button onClick={() => set("target", Math.max(1, d.target - 1))} style={navBtn(C)} aria-label="Fewer">
            <ChevronLeft size={16} />
          </button>
          <span className="apex-num" style={{ fontSize: 26, minWidth: 34, textAlign: "center" }}>{d.target}</span>
