}

/* --------------------------------- habits -------------------------------- */

function HabitsScreen({ C, state, ledger, onToggle, onEdit, onAdd, onEditGoal, onAddGoal, onGoal }) {
  const today = todayKey();
  const day = state.log[today] || { habits: {} };
  const last14 = Array.from({ length: 14 }, (_, i) => shiftKey(today, i - 13));

  return (
    <div>
      <SectionTitle C={C}>Habits</SectionTitle>
      {state.habits.length === 0 ? (
        <Empty C={C} title="No habits yet" body="Habits repeat on the days you choose and feed the same XP pool as your sessions." onAdd={onAdd} />
      ) : (
        <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
          {state.habits.map((h) => {
            const scheduled = h.days.includes(dowOf(today));
            const done = !!day.habits[h.id];
            let run = 0;
            for (let i = 0; i < 400; i++) {
              const k = shiftKey(today, -i);
              if (!h.days.includes(dowOf(k))) continue;
              const e = state.log[k];
              if (e && e.habits && e.habits[h.id]) run++;
              else if (i === 0) continue;
              else break;
            }
            return (
              <div key={h.id} style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 14, padding: 13 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 11 }}>
                  <button disabled={!scheduled} onClick={() => onToggle(today, h)} style={{
                    width: 27, height: 27, borderRadius: 9, flexShrink: 0, display: "grid", placeItems: "center",
                    background: done ? CATEGORIES[h.category] : "transparent",
                    border: `2px solid ${done ? CATEGORIES[h.category] : C.line}`,
                    color: "#0F1420", cursor: scheduled ? "pointer" : "default", opacity: scheduled ? 1 : .4,
                  }}>{done && <Check size={16} strokeWidth={3.4} />}</button>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontSize: 14.5, fontWeight: 600 }}>{h.name || "Untitled habit"}</div>
                    <div style={{ fontSize: 11.5, color: C.dim, display: "flex", gap: 8, marginTop: 2 }}>
                      <span style={{ color: CATEGORIES[h.category] }}>{h.category}</span>
                      <span>+{DIFFICULTY[h.difficulty]} XP</span>
                      {run > 0 && <span style={{ color: EMBER }}>{run}-day run</span>}
                    </div>
                  </div>
                  <button onClick={() => onEdit(h)} aria-label="Edit habit" style={{ background: "none", border: "none", color: C.faint, cursor: "pointer", padding: 6 }}>
                    <Pencil size={14} />
                  </button>
                </div>
                <div style={{ display: "flex", gap: 3, marginTop: 11 }}>
                  {last14.map((k) => {
                    const sched = h.days.includes(dowOf(k));
                    const e = state.log[k];
                    const hit = e && e.habits && e.habits[h.id];
                    return (
                      <div key={k} title={k} style={{
                        flex: 1, height: 6, borderRadius: 3,
                        background: hit ? CATEGORIES[h.category] : sched ? C.panel2 : "transparent",
                        border: sched && !hit ? `1px solid ${C.line}` : "none",
                      }} />
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      )}

      <button onClick={onAdd} style={{
        marginTop: 14, width: "100%", background: "none", border: `1px dashed ${C.line}`,
        borderRadius: 14, padding: 13, color: C.dim, cursor: "pointer",
        display: "flex", alignItems: "center", justifyContent: "center", gap: 8, fontSize: 13.5,
      }}><Plus size={16} /> Add a habit</button>

      <SectionTitle C={C}>Weekly goals</SectionTitle>
      {(state.goals || []).length === 0 ? (
        <Empty C={C} title="No weekly goals" body="Goals are counted per week rather than tied to a day — three cardio sessions, sheets washed once, that shape." />
      ) : (
        <>
          <GoalStrip C={C} state={state} dayKey={todayKey()} onGoal={onGoal} />
          <div style={{ display: "flex", flexDirection: "column", gap: 6, marginTop: 10 }}>
            {(state.goals || []).map((g) => (
              <button key={g.id} onClick={() => onEditGoal(g)} style={{
                background: "none", border: "none", color: C.faint, cursor: "pointer",
                fontSize: 12, textAlign: "left", padding: "2px 0", display: "flex",
                alignItems: "center", gap: 7,
              }}>
                <Pencil size={12} /> Edit {g.name}
              </button>
            ))}
          </div>
          <GoalHistory C={C} state={state} />
        </>
      )}
      <button onClick={onAddGoal} style={{
        marginTop: 12, width: "100%", background: "none", border: `1px dashed ${C.line}`,
        borderRadius: 14, padding: 13, color: C.dim, cursor: "pointer",
        display: "flex", alignItems: "center", justifyContent: "center", gap: 8, fontSize: 13.5,
      }}><Plus size={16} /> Add a weekly goal</button>

      <SectionTitle C={C}>Weekly schedule</SectionTitle>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 14, padding: 13 }}>
        {DOW.map((d, i) => {
          const n = state.schedule.filter((t) => t.days.includes(i)).length;
          const mins = state.schedule.filter((t) => t.days.includes(i))
            .reduce((s, t) => s + durationOf(t), 0);
          return (
            <div key={d} style={{
              display: "flex", alignItems: "center", gap: 11, padding: "7px 0",
              borderBottom: i < 6 ? `1px solid ${C.line}` : "none",
            }}>
              <span className="apex-num" style={{ width: 38, fontSize: 13, color: C.dim }}>{d}</span>
              <div style={{ flex: 1 }}>
                <Bar pct={Math.min(100, (mins / 300) * 100)} color={n ? CATEGORIES.Revision : C.line} track={C.panel2} height={6} />
              </div>
              <span style={{ fontSize: 11.5, color: C.faint, width: 74, textAlign: "right" }}>
                {n} · {Math.floor(mins / 60)}h {mins % 60}m
              </span>
            </div>
          );
        })}
      </div>
    </div>
  );
}

function GoalHistory({ C, state }) {
  const goals = state.goals || [];
  const weeks = Array.from({ length: 6 }, (_, i) => shiftKey(weekStartOf(todayKey()), (i - 5) * 7));
  return (
    <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 14, padding: 13, marginTop: 12 }}>
      <div style={{ fontSize: 12, color: C.dim, marginBottom: 10 }}>Last six weeks</div>
      {goals.map((g) => (
        <div key={g.id} style={{ display: "flex", alignItems: "center", gap: 9, marginBottom: 8 }}>
          <span style={{ fontSize: 12, color: C.dim, width: 96, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
            {g.name}
          </span>
          <div style={{ display: "flex", gap: 4, flex: 1 }}>
            {weeks.map((w) => {
              const c = weekGoalCounts(state, w)[g.id] || 0;
              const met = c >= g.target;
              return (
                <div key={w} title={`${w}: ${c}/${g.target}`} style={{
                  flex: 1, height: 20, borderRadius: 5,
                  background: met ? CATEGORIES[g.category] : c > 0 ? CATEGORIES[g.category] + "44" : C.panel2,
                  border: `1px solid ${met ? CATEGORIES[g.category] : C.line}`,
                  display: "grid", placeItems: "center", fontSize: 10, fontWeight: 700,
                  color: met ? "#0F1420" : C.faint, fontFamily: "Archivo, Inter, sans-serif",
                }}>{c || ""}</div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  );
}

/* ---------------------------------- stats -------------------------------- */

function StatsScreen({ C, state, ledger, lvl }) {
  const s = ledger.stats;
  const today = todayKey();
  const last14 = Array.from({ length: 14 }, (_, i) => shiftKey(today, i - 13));
  const xpByDay = last14.map((k) => {
    const d = ledger.days.find((x) => x.key === k);
    return { k, xp: d ? d.total : 0 };
  });
  const maxXp = Math.max(50, ...xpByDay.map((d) => d.xp));

  const weeks = 13;
  const heat = [];
  const anchor = shiftKey(today, -dowOf(today)); // Monday of this week
  for (let w = weeks - 1; w >= 0; w--) {
    const col = [];
    for (let d = 0; d < 7; d++) col.push(shiftKey(anchor, -w * 7 + d));
    heat.push(col);
  }
  const rateOf = (k) => {
    const d = ledger.days.find((x) => x.key === k);
    if (!d) return null;
    if (parseKey(k) > parseKey(today)) return null;
    return d.rate;
  };

  const totalPlanned = ledger.days.reduce((a, d) => a + d.planned, 0);
  const totalDone = ledger.days.reduce((a, d) => a + d.doneCount, 0);
  const success = totalPlanned ? Math.round((totalDone / totalPlanned) * 100) : 0;

  const catTotals = CAT_KEYS.map((c) => ({ c, n: s[`cat:${c}`] || 0 })).filter((x) => x.n > 0)
    .sort((a, b) => b.n - a.n);
  const catMax = Math.max(1, ...catTotals.map((x) => x.n));

  return (
    <div>
      <SectionTitle C={C}>Your numbers</SectionTitle>
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 9 }}>
        <Stat C={C} label="Total XP" value={ledger.totalXp.toLocaleString()} color={XP_C}
          sub={`${ledger.achXp.toLocaleString()} from awards`} />
        <Stat C={C} label="Current streak" value={s.streak} color={EMBER} sub={`best ${s.bestStreak}`} />
        <Stat C={C} label="Sessions done" value={s.tasksDone.toLocaleString()} sub={`${s.habitsDone} habits ticked`} />
        <Stat C={C} label="Success rate" value={`${success}%`} color={success >= 80 ? MINT : undefined}
          sub={`${totalDone} of ${totalPlanned} planned`} />
        <Stat C={C} label="Hours banked" value={`${Math.floor(s.minutes / 60)}h`} sub={`${s.minutes % 60}m over ${s.daysActive} days`} />
        <Stat C={C} label="Perfect days" value={s.perfectDays} color={ICE} sub={`${s.perfectWeeks} perfect weeks`} />
      </div>

      <SectionTitle C={C}>XP, last 14 days</SectionTitle>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 16, padding: "16px 14px 10px" }}>
        <div style={{ display: "flex", alignItems: "flex-end", gap: 5, height: 116 }}>
          {xpByDay.map((d) => (
            <div key={d.k} style={{ flex: 1, display: "flex", flexDirection: "column", justifyContent: "flex-end", alignItems: "center", gap: 6, height: "100%" }}>
              <div title={`${d.k}: ${d.xp} XP`} style={{
                width: "100%", height: `${(d.xp / maxXp) * 100}%`, minHeight: d.xp > 0 ? 4 : 2,
                background: d.xp > 0 ? `linear-gradient(180deg, ${XP_C}, #FF8A3D)` : C.panel2,
                borderRadius: "4px 4px 2px 2px", transition: "height .5s ease",
              }} />
              <span style={{ fontSize: 9, color: C.faint }}>{DOW[dowOf(d.k)][0]}</span>
            </div>
          ))}
        </div>
      </div>

      <SectionTitle C={C}>Consistency</SectionTitle>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 16, padding: 15, overflowX: "auto" }}>
        <div style={{ display: "flex", gap: 3, minWidth: 300 }}>
          {heat.map((col, i) => (
            <div key={i} style={{ display: "flex", flexDirection: "column", gap: 3, flex: 1 }}>
              {col.map((k) => {
                const r = rateOf(k);
                const bg = r === null ? C.panel2
                  : r >= 1 ? MINT : r >= .6 ? XP_C : r > 0 ? "#8B6A2E" : C.panel2;
                return <div key={k} title={`${k}${r === null ? "" : ` · ${Math.round(r * 100)}%`}`}
                  style={{ paddingTop: "100%", borderRadius: 3, background: bg, opacity: r === null ? .55 : 1 }} />;
              })}
            </div>
          ))}
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 12, marginTop: 12, fontSize: 11, color: C.faint }}>
          <span style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <i style={{ width: 9, height: 9, borderRadius: 2, background: MINT, display: "inline-block" }} /> everything
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <i style={{ width: 9, height: 9, borderRadius: 2, background: XP_C, display: "inline-block" }} /> most of it
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <i style={{ width: 9, height: 9, borderRadius: 2, background: C.panel2, display: "inline-block" }} /> nothing logged
          </span>
        </div>
      </div>

      {catTotals.length > 0 && (
        <>
          <SectionTitle C={C}>Where the time goes</SectionTitle>
          <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 16, padding: 15 }}>
            {catTotals.map((x, i) => (
              <div key={x.c} style={{ marginBottom: i < catTotals.length - 1 ? 12 : 0 }}>
                <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12.5, marginBottom: 5 }}>
                  <span style={{ color: C.text }}>{x.c}</span>
                  <span className="apex-num" style={{ color: C.dim }}>{x.n}</span>
                </div>
                <Bar pct={(x.n / catMax) * 100} color={CATEGORIES[x.c]} track={C.panel2} height={7} />
              </div>
            ))}
          </div>
        </>
      )}

      <SectionTitle C={C}>Level {lvl.level}</SectionTitle>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 16, padding: 16 }}>
        <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12.5, color: C.dim, marginBottom: 8 }}>
          <span>{rankFor(lvl.level)}</span>
          <span className="apex-num">{lvl.into.toLocaleString()} / {lvl.need.toLocaleString()}</span>
        </div>
        <Bar pct={lvl.pct} color={`linear-gradient(90deg, ${ICE}, #3B7BD6)`} track={C.panel2} height={9} />
        <div style={{ fontSize: 12, color: C.faint, marginTop: 10, lineHeight: 1.5 }}>
          Next rank at level {(RANKS.find(([m]) => m > lvl.level) || [100, "Apex"])[0]} — {(RANKS.find(([m]) => m > lvl.level) || [100, "Apex"])[1]}.
        </div>
      </div>
    </div>
  );
}

/* --------------------------------- awards -------------------------------- */

function AwardsScreen({ C, ledger }) {
  const [filter, setFilter] = useState("All");
  const unlocked = new Set(ledger.unlockedIds);
  const groups = ["All", ...Object.keys(ACH_BY_GROUP)];
  const list = filter === "All" ? ACHIEVEMENTS : ACH_BY_GROUP[filter];
  const shown = [...list].sort((a, b) => {
    const ua = unlocked.has(a.id), ub = unlocked.has(b.id);
    if (ua !== ub) return ua ? -1 : 1;
    return a.target - b.target;
  });

  return (
    <div>
      <div style={{ display: "flex", alignItems: "baseline", gap: 10, margin: "20px 0 12px" }}>
        <span className="apex-num" style={{ fontSize: 30, letterSpacing: "-.03em" }}>{unlocked.size}</span>
        <span style={{ fontSize: 13, color: C.dim }}>of {ACHIEVEMENTS.length} unlocked</span>
      </div>
      <Bar pct={(unlocked.size / ACHIEVEMENTS.length) * 100} color={`linear-gradient(90deg, ${XP_C}, ${EMBER})`} track={C.panel2} height={7} />

      <div style={{ display: "flex", gap: 7, overflowX: "auto", padding: "14px 0", marginBottom: 4 }}>
        {groups.map((g) => (
          <Chip key={g} active={filter === g} onClick={() => setFilter(g)} C={C} small>{g}</Chip>
        ))}
      </div>

      <div style={{ display: "grid", gap: 8 }}>
        {shown.map((a) => {
          const on = unlocked.has(a.id);
          const col = RARITY_C[a.rarity];
          const progress = Math.min(100, ((ledger.stats[a.metric] || 0) / a.target) * 100);
          return (
            <div key={a.id} style={{
              background: C.panel, border: `1px solid ${on ? col + "55" : C.line}`,
              borderRadius: 14, padding: 13, display: "flex", gap: 12, alignItems: "center",
            }}>
              <div style={{
                width: 38, height: 38, borderRadius: 11, flexShrink: 0, display: "grid", placeItems: "center",
                background: on ? col : C.panel2, color: on ? "#0F1420" : C.faint,
                border: on ? "none" : `1px solid ${C.line}`,
              }}>
                {on ? <Trophy size={18} /> : <Lock size={15} />}
              </div>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <span style={{ fontSize: 14, fontWeight: 650, color: on ? C.text : C.dim }}>{a.name}</span>
                  <span style={{ fontSize: 10, color: col, border: `1px solid ${col}44`, borderRadius: 99, padding: "1px 7px" }}>
                    {a.rarity}
                  </span>
                </div>
                <div style={{ fontSize: 11.5, color: C.faint, marginTop: 2 }}>{a.desc}</div>
                {!on && progress > 0 && (
                  <div style={{ marginTop: 7 }}>
                    <Bar pct={progress} color={col} track={C.panel2} height={4} />
                  </div>
                )}
              </div>
              <span className="apex-num" style={{ fontSize: 12.5, color: on ? XP_C : C.faint, flexShrink: 0 }}>+{a.xp}</span>
            </div>
          );
        })}
      </div>
    </div>
  );
}

/* --------------------------------- review -------------------------------- */

function ReviewScreen({ C, state, ledger, setState }) {
  const today = todayKey();
  const day = ledger.days.find((d) => d.key === today);
  const tasks = tasksForDate(state.schedule, today);
  const entry = state.log[today] || { tasks: {}, habits: {}, note: "" };
  const missed = tasks.filter((t) => !entry.tasks[t.id]);
  const pct = day && day.planned ? Math.round((day.doneCount / day.planned) * 100) : 0;

  const verdict =
    pct === 100 ? "Perfect. Nothing left on the board."
      : pct >= 80 ? "Strong day. That's the standard."
        : pct >= 50 ? "Half held. The gap is where tomorrow's plan goes."
          : pct > 0 ? "Started, not finished. One session is still one session."
            : "Blank day. Tick one thing and the streak restarts tonight.";

  const suggestions = [];
  if (missed.length) {
    const late = missed.filter((t) => !t.anytime && toMin(t.start) >= 1200);
    if (late.length >= 2) suggestions.push("Two or more misses came after 20:00 — try moving one session earlier.");
    const cats = [...new Set(missed.map((t) => t.category))];
    if (cats.length === 1) suggestions.push(`Every miss today was ${cats[0]}. Worth checking whether those slots are realistic.`);
  }
  if (ledger.stats.streak >= 7) suggestions.push(`Your streak multiplier is ${streakMult(ledger.stats.streak).toFixed(2)}× — every session is worth more right now.`);
  if (!suggestions.length && pct === 100) suggestions.push("Consider adding one harder session — you're clearing the plan comfortably.");
  if (!suggestions.length) suggestions.push("Pick tomorrow's first session tonight so you don't decide in the morning.");

  return (
    <div>
      <SectionTitle C={C}>Today's review</SectionTitle>
      <div style={{
        background: C.panel, border: `1px solid ${C.line}`, borderRadius: 18, padding: 18, boxShadow: C.shadow,
      }}>
        <div style={{ display: "flex", alignItems: "baseline", gap: 8 }}>
          <span className="apex-num" style={{ fontSize: 46, letterSpacing: "-.035em" }}>{pct}</span>
          <span className="apex-num" style={{ fontSize: 22, color: C.dim }}>%</span>
        </div>
        <div style={{ fontSize: 14, color: C.text, marginTop: 4 }}>{verdict}</div>
        <div style={{ fontSize: 12.5, color: C.dim, marginTop: 3 }}>
          {ledger.stats.streak}-day streak {day && day.neutral ? "paused — rest day" : day && day.qualified ? "held" : "at risk"}.
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 9, marginTop: 16 }}>
          <MiniStat C={C} label="Done" value={day ? day.doneCount : 0} />
          <MiniStat C={C} label="Missed" value={missed.length} color={missed.length ? EMBER : undefined} />
          <MiniStat C={C} label="XP" value={day ? day.total : 0} color={XP_C} />
        </div>

        {day && day.total > 0 && (
          <div style={{ marginTop: 14, fontSize: 12, color: C.dim, lineHeight: 1.7 }}>
            <div style={{ display: "flex", justifyContent: "space-between" }}>
              <span>Sessions and habits</span><span className="apex-num">{day.rawTaskXp + day.rawHabitXp}</span>
            </div>
            <div style={{ display: "flex", justifyContent: "space-between" }}>
              <span>Streak multiplier</span><span className="apex-num">{day.mult.toFixed(2)}×</span>
            </div>
            {day.bonuses.map((b) => (
              <div key={b.label} style={{ display: "flex", justifyContent: "space-between", color: XP_C }}>
                <span>{b.label}</span><span className="apex-num">+{b.xp}</span>
              </div>
            ))}
            <div style={{ display: "flex", justifyContent: "space-between", color: C.text, borderTop: `1px solid ${C.line}`, marginTop: 6, paddingTop: 6 }}>
              <span>Total</span><span className="apex-num">{day.total}</span>
            </div>
          </div>
        )}
      </div>

      {missed.length > 0 && (
        <>
          <SectionTitle C={C}>Left on the board</SectionTitle>
          <div style={{ display: "flex", flexDirection: "column", gap: 7 }}>
            {missed.map((t) => (
              <div key={t.id} style={{
                background: C.panel, border: `1px solid ${C.line}`, borderRadius: 12,
                padding: "10px 13px", display: "flex", justifyContent: "space-between", fontSize: 13,
              }}>
                <span style={{ color: C.dim }}>{t.name}</span>
                <span style={{ color: C.faint, fontSize: 11.5 }}>{t.anytime ? `${t.minutes} min` : t.start}</span>
              </div>
            ))}
          </div>
        </>
      )}

      <SectionTitle C={C}>What to change</SectionTitle>
      <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 14, padding: 15 }}>
        {suggestions.map((s, i) => (
          <div key={i} style={{ display: "flex", gap: 9, marginBottom: i < suggestions.length - 1 ? 10 : 0 }}>
            <Sparkles size={15} color={XP_C} style={{ flexShrink: 0, marginTop: 2 }} />
            <span style={{ fontSize: 13, color: C.dim, lineHeight: 1.5 }}>{s}</span>
          </div>
        ))}
      </div>

      <SectionTitle C={C}>Note for tomorrow</SectionTitle>
      <textarea
        value={entry.note || ""}
        onChange={(e) => {
          const v = e.target.value;
          setState((s) => {
            const cur = s.log[today] || { planned: coreCount(s.schedule, today), tasks: {}, habits: {} };
            return { ...s, log: { ...s.log, [today]: { ...cur, note: v } } };
          });
        }}
        placeholder="One line on what got in the way."
        rows={3}
        style={{
          width: "100%", background: C.panel, border: `1px solid ${C.line}`, borderRadius: 12,
          padding: 12, color: C.text, fontSize: 13.5, fontFamily: "inherit", resize: "vertical",
        }}
      />
    </div>
  );
}

function MiniStat({ C, label, value, color }) {
  return (
    <div style={{ background: C.panel2, borderRadius: 11, padding: "10px 11px" }}>
      <div className="apex-num" style={{ fontSize: 20, color: color || C.text }}>{value}</div>
      <div style={{ fontSize: 11, color: C.dim, marginTop: 2 }}>{label}</div>
    </div>
  );
}

