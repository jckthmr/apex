button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid ${XP_C}; outline-offset: 2px; }
input, textarea { outline: none; }
::-webkit-scrollbar { height: 0; width: 0; }
@keyframes apexPop { 0% { transform: scale(.7); opacity: .4 } 55% { transform: scale(1.12) } 100% { transform: scale(1); opacity: 1 } }
@keyframes apexRise { from { transform: translateY(26px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
@keyframes apexToast { from { transform: translateY(14px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
