}

function Toggle({ C, on, color, onClick, label, last }) {
  return (
    <button onClick={onClick} style={{
      display: "flex", alignItems: "center", gap: 9, background: "none", border: "none",
      color: C.dim, cursor: "pointer", padding: 0, marginBottom: last ? 18 : 11,
      fontSize: 13, textAlign: "left",
    }}>
      <span style={{
        width: 20, height: 20, borderRadius: 6, flexShrink: 0, display: "grid", placeItems: "center",
        background: on ? color : "transparent", border: `2px solid ${on ? color : C.line}`, color: "#0F1420",
      }}>{on && <Check size={12} strokeWidth={3.4} />}</span>
      {label}
