function GoalLogSheet({ goal, C, onClose, onLog }) {
  const [mins, setMins] = useState(45);
  useEffect(() => { if (goal) setMins(goal.minMinutes || 30); }, [goal]);
  if (!goal) return null;
  const min = goal.minMinutes || 0;
  const short = mins < min;
  const picks = [min, min + 15, min + 30, min + 45].filter((x) => x > 0);

  return (
    <Sheet open={!!goal} onClose={onClose} title={`Log ${goal.name}`} C={C}>
      <div style={{ fontSize: 13, color: C.dim, marginBottom: 14, lineHeight: 1.5 }}>
        Anything under {min} minutes still earns XP, but it won't count toward your weekly target.
      </div>
      <Field label="How long" C={C}>
        <div style={{ display: "flex", gap: 6, marginBottom: 10, flexWrap: "wrap" }}>
          {picks.map((x) => (
            <Chip key={x} active={mins === x} color={CATEGORIES[goal.category]} onClick={() => setMins(x)} C={C} small>
              {x} min
            </Chip>
          ))}
        </div>
        <input type="number" min="1" value={mins}
          onChange={(e) => setMins(Math.max(0, parseInt(e.target.value || "0", 10)))}
          style={inputStyle(C)} />
      </Field>
      {short && (
        <div style={{ fontSize: 12.5, color: EMBER, marginBottom: 14 }}>
          {min - mins} minutes short of the target minimum.
        </div>
      )}
      <button onClick={() => onLog(mins)} style={{
        width: "100%", background: XP_C, color: "#1A1206", border: "none", borderRadius: 11,
        padding: 13, fontWeight: 700, fontSize: 14, cursor: "pointer",
      }}>Log {mins} minutes</button>
    </Sheet>
  );
}

