    <div style={{ display: "flex", gap: 6 }}>
      {DOW.map((d, i) => {
        const on = days.includes(i);
        return (
          <button key={d} onClick={() => onChange(on ? days.filter((x) => x !== i) : [...days, i].sort())}
            style={{
              flex: 1, background: on ? C.text : C.panel2, color: on ? C.bg : C.dim,
              border: `1px solid ${on ? C.text : C.line}`, borderRadius: 9, padding: "8px 0",
              fontSize: 11.5, fontWeight: 600, cursor: "pointer",
            }}>{d[0]}</button>
        );
      })}
    </div>
