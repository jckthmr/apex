/* --------------------------------- levels -------------------------------- */

// XP required to advance from level L to L+1.
const xpToNext = (L) => Math.round(60 * Math.pow(L, 1.2)) + 100;

const CUM = (() => {
  const arr = [0, 0]; // index = level, value = total XP needed to reach it
  for (let L = 1; L <= 120; L++) arr[L + 1] = arr[L] + xpToNext(L);
  return arr;
})();

function levelFromXp(xp) {
  let L = 1;
  while (L < 100 && xp >= CUM[L + 1]) L++;
  const floorXp = CUM[L], ceilXp = L >= 100 ? CUM[100] : CUM[L + 1];
  const span = Math.max(1, ceilXp - floorXp);
  return {
    level: L,
    into: Math.max(0, xp - floorXp),
    need: span,
    pct: L >= 100 ? 100 : Math.min(100, ((xp - floorXp) / span) * 100),
  };
}

