/* ---------------------------------- ledger -------------------------------- */
/* Everything is recomputed from the log, so totals can never drift out of sync
   with what actually got ticked. */

const streakMult = (streak) => 1 + Math.min(streak, 30) * 0.02; // caps at 1.60x

// Untimed sessions carry a duration instead of a start and end, and sort to the bottom.
const durationOf = (t) => t.anytime
  ? (t.minutes || 0)
  : Math.max(0, toMin(t.end) - toMin(t.start));

function tasksForDate(schedule, key) {
  const d = dowOf(key);
  return schedule.filter((t) => t.days.includes(d)).sort((a, b) => {
    if (!a.anytime !== !b.anytime) return a.anytime ? 1 : -1;
    if (a.anytime) return 0;
    return toMin(a.start) - toMin(b.start);
  });
}
function habitsForDate(habits, key) {
  const d = dowOf(key);
  return habits.filter((h) => h.days.includes(d));
}
// Optional sessions pay XP but never count against you, so they sit outside the plan.
const coreCount = (schedule, key) => tasksForDate(schedule, key).filter((t) => !t.optional).length;

// Weekly goals are a count per week with no fixed day. Weeks run Monday to Sunday.
const weekStartOf = (key) => shiftKey(key, -dowOf(key));

function weekGoalCounts(state, key) {
  const ws = weekStartOf(key), counts = {};
  for (let i = 0; i < 7; i++) {
    const e = state.log[shiftKey(ws, i)];
    if (!e || !e.goals) continue;
    Object.keys(e.goals).forEach((id) => {
      if (e.goals[id].ok !== false) counts[id] = (counts[id] || 0) + 1;
    });
  }
  return counts;
}

function buildLedger(state) {
  const logKeys = Object.keys(state.log).sort();
  const today = todayKey();
  const start = logKeys.length ? logKeys[0] : today;

  const days = [];
  const st = {
    baseXp: 0, tasksDone: 0, habitsDone: 0, perfectDays: 0, perfectWeeks: 0,
    daysActive: 0, minutes: 0, maxTasksInDay: 0, earlyTasks: 0, lateTasks: 0,
    weekendPerfect: 0, comebacks: 0, bestDayXp: 0, bestStreak: 0, streak: 0,
    freezesUsed: 0, missed: 0, extraSessions: 0, goalsHit: 0, goalTargets: 0, goalWeeks: 0,
  };
  CAT_KEYS.forEach((c) => { st[`cat:${c}`] = 0; });

  const goalDefs = state.goals || [];
  let curWeek = null, weekCount = {}, weekAwarded = {};
  let streak = 0, prevQualified = true, hadStreak = 0;
  let cursor = start;
  let guard = 0;

  while (guard++ < 4000) {
    const entry = state.log[cursor] || null;
    const planned = entry && typeof entry.planned === "number"
      ? entry.planned : coreCount(state.schedule, cursor);
    const tasks = (entry && entry.tasks) || {};
    const habits = (entry && entry.habits) || {};
    const goals = (entry && entry.goals) || {};
    const goalIds = Object.keys(goals);
    const taskIds = Object.keys(tasks), habitIds = Object.keys(habits);

    const wk = weekStartOf(cursor);
    if (wk !== curWeek) { curWeek = wk; weekCount = {}; weekAwarded = {}; }
    const doneCount = taskIds.filter((id) => !tasks[id].opt).length;
    const doneExtra = taskIds.length - doneCount;
    const habitCount = habitIds.length;

    const rawTaskXp = taskIds.reduce((s, id) => s + (tasks[id].xp || 0), 0);
    const rawHabitXp = habitIds.reduce((s, id) => s + (habits[id].xp || 0), 0);
    const rawGoalXp = goalIds.reduce((s, id) => s + (goals[id].xp || 0), 0);
    const mult = streakMult(streak);
    let total = Math.round((rawTaskXp + rawHabitXp + rawGoalXp) * mult);

    const offPlanWork = habitCount + goalIds.length;
    const rate = planned > 0 ? doneCount / planned : (offPlanWork > 0 ? 1 : 0);
    const qualified = doneCount + offPlanWork > 0 && rate >= 0.6;
    const frozen = !qualified && !!state.freezes[cursor];

    const habitsPlanned = habitsForDate(state.habits, cursor).length;
    const perfect = planned >= 3 && doneCount >= planned &&
      (habitsPlanned === 0 || habitCount >= habitsPlanned);

    const bonuses = [];
    if (doneExtra > 0) {
      const xp = EXTRA_BONUS * doneExtra;
      bonuses.push({ label: doneExtra > 1 ? `${doneExtra} extra sessions` : "Extra session", xp });
      total += xp;
    }
    if (perfect) { bonuses.push({ label: "Perfect day", xp: 250 }); total += 250; }

    goalIds.forEach((id) => { if (goals[id].ok !== false) weekCount[id] = (weekCount[id] || 0) + 1; });
    goalDefs.forEach((g) => {
      if (!weekAwarded[g.id] && (weekCount[g.id] || 0) >= g.target) {
        weekAwarded[g.id] = true;
        bonuses.push({ label: `${g.name} target hit`, xp: GOAL_BONUS });
        total += GOAL_BONUS;
        st.goalTargets++;
      }
    });
    if (goalDefs.length && !weekAwarded.__all && goalDefs.every((g) => weekAwarded[g.id])) {
      weekAwarded.__all = true;
      bonuses.push({ label: "Every weekly goal met", xp: ALL_GOALS_BONUS });
      total += ALL_GOALS_BONUS;
      st.goalWeeks++;
    }

    // A day with nothing on it is a rest day, not a failure: it holds the streak
    // without extending it.
    const neutral = planned === 0 && habitsPlanned === 0 &&
      taskIds.length + habitCount + goalIds.length === 0;

    if (neutral) {
      // carry the streak through untouched
    } else if (qualified) {
      if (!prevQualified && hadStreak >= 3) st.comebacks++;
      streak++;
      st.daysActive++;
    } else if (frozen) {
      st.freezesUsed++;
    } else {
      if (cursor !== today || taskIds.length + offPlanWork > 0) st.missed++;
      streak = 0;
    }
    hadStreak = Math.max(hadStreak, streak);
    st.bestStreak = Math.max(st.bestStreak, streak);

    // Perfect week bonus lands on Sunday.
    if (dowOf(cursor) === 6) {
      const week = [...days.slice(-6), { qualified, neutral }];
      const active = week.filter((d) => !d.neutral);
      const full = week.length === 7 && active.length >= 4 && active.every((d) => d.qualified);
      if (full) { bonuses.push({ label: "Perfect week", xp: 500 }); total += 500; st.perfectWeeks++; }
    }

    st.baseXp += total;
    st.tasksDone += taskIds.length;
    st.extraSessions += doneExtra;
    st.goalsHit += goalIds.length;
    goalIds.forEach((id) => {
      st.minutes += goals[id].min || 0;
      if (goals[id].cat && st[`cat:${goals[id].cat}`] !== undefined) st[`cat:${goals[id].cat}`]++;
    });
    st.habitsDone += habitCount;
    st.bestDayXp = Math.max(st.bestDayXp, total);
    st.maxTasksInDay = Math.max(st.maxTasksInDay, taskIds.length);
    if (perfect) {
      st.perfectDays++;
      if (dowOf(cursor) >= 5) st.weekendPerfect++;
    }
    taskIds.forEach((id) => {
      const t = tasks[id];
      st.minutes += t.min || 0;
      if (t.cat && st[`cat:${t.cat}`] !== undefined) st[`cat:${t.cat}`]++;
      if (t.start) {
        const m = toMin(t.start);
        if (m < 420) st.earlyTasks++;
        if (m >= 1290) st.lateTasks++;
      }
    });

    days.push({
      key: cursor, planned, doneCount, doneExtra, habitCount, habitsPlanned, goalCount: goalIds.length, rate, qualified,
      neutral, frozen, perfect, total, mult, bonuses, rawTaskXp, rawHabitXp, streakAfter: streak,
    });

    if (!neutral) prevQualified = qualified || frozen;
    if (cursor === today) break;
    cursor = shiftKey(cursor, 1);
    if (parseKey(cursor) > parseKey(today)) break;
  }

  // Longest single-habit run.
  let habitBest = 0;
  state.habits.forEach((h) => {
    let run = 0, best = 0;
    days.forEach((d) => {
      const e = state.log[d.key];
      const scheduled = h.days.includes(dowOf(d.key));
      if (!scheduled) return;
      if (e && e.habits && e.habits[h.id]) { run++; best = Math.max(best, run); }
      else if (d.key !== todayKey()) run = 0;
    });
    habitBest = Math.max(habitBest, best);
  });

  st.habitBestStreak = habitBest;
  st.hours = Math.floor(st.minutes / 60);
  st.streak = streak;
  st.baseLevel = levelFromXp(st.baseXp).level;

  const earnedFreezes = Math.min(3, Math.floor(st.daysActive / 7) - st.freezesUsed);
  st.freezesAvailable = Math.max(0, earnedFreezes);

  // Achievements evaluate against base progress, then pay out on top.
  const unlocked = ACHIEVEMENTS.filter((a) => (st[a.metric] || 0) >= a.target);
  const achXp = unlocked.reduce((s, a) => s + a.xp, 0);
  const totalXp = st.baseXp + achXp;

  return { days, stats: st, unlocked, unlockedIds: unlocked.map((a) => a.id), achXp, totalXp };
}

/* --------------------------------- storage ------------------------------- */

const KEY = "apex:state:v3";

async function loadState() {
  try {
    const r = await window.storage.get(KEY);
    if (r && r.value) {
      const saved = JSON.parse(r.value);
      const merged = { ...DEFAULT_STATE, ...saved };
      // A saved schedule would otherwise shadow every later edit to the plan.
      if ((saved.planRev || 0) < PLAN_REV) {
        merged.schedule = DEFAULT_SCHEDULE;
        merged.habits = DEFAULT_HABITS;
        merged.goals = DEFAULT_GOALS;
        merged.planRev = PLAN_REV;
      }
      return merged;
    }
  } catch (e) { /* first run, or storage unavailable */ }
  return null;
}
async function saveState(s) {
  try { await window.storage.set(KEY, JSON.stringify(s)); } catch (e) { /* offline is fine */ }
}

