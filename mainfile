function Stat({ label, value, sub, color, C }) {
  return (
    <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 14, padding: "14px 14px 12px" }}>
      <div className="apex-num" style={{ fontSize: 26, color: color || C.text, lineHeight: 1 }}>{value}</div>
      <div style={{ fontSize: 12, color: C.dim, marginTop: 6 }}>{label}</div>
      {sub && <div style={{ fontSize: 11, color: C.faint, marginTop: 2 }}>{sub}</div>}
    </div>
  );
}

function Sheet({ open, onClose, title, children, C }) {
  if (!open) return null;
  return (
    <div
      onClick={onClose}
      style={{
        position: "fixed", inset: 0, background: "rgba(6,9,14,.62)", zIndex: 60,
        display: "flex", alignItems: "flex-end", justifyContent: "center",
        backdropFilter: "blur(3px)",
      }}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="apex-rise"
        style={{
          background: C.panel, borderTop: `1px solid ${C.line}`, width: "100%", maxWidth: 560,
          borderRadius: "20px 20px 0 0", padding: 18, maxHeight: "88vh", overflowY: "auto",
          boxShadow: C.shadow,
        }}
      >
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 14 }}>
          <h2 className="apex-num" style={{ fontSize: 20, color: C.text, margin: 0 }}>{title}</h2>
          <button onClick={onClose} aria-label="Close"
            style={{ background: C.panel2, border: `1px solid ${C.line}`, color: C.dim, borderRadius: 10, padding: 7, cursor: "pointer" }}>
            <X size={16} />
          </button>
        </div>
        {children}
      </div>
    </div>
  );
}

function Field({ label, children, C }) {
  return (
    <label style={{ display: "block", marginBottom: 14 }}>
      <div style={{ fontSize: 12, color: C.dim, marginBottom: 6 }}>{label}</div>
      {children}
    </label>
  );
}

function Chip({ active, onClick, color, children, C, small }) {
  return (
    <button onClick={onClick} style={{
      background: active ? (color || C.text) : C.panel2,
      color: active ? (color ? "#0F1420" : C.bg) : C.dim,
      border: `1px solid ${active ? (color || C.text) : C.line}`,
      borderRadius: 99, padding: small ? "5px 10px" : "7px 13px",
      fontSize: small ? 11 : 13, fontWeight: 600, cursor: "pointer", whiteSpace: "nowrap",
    }}>{children}</button>
  );
}

/* --------------------------------- the app ------------------------------- */

export default function ApexApp() {
  const [state, setState] = useState(DEFAULT_STATE);
  const [ready, setReady] = useState(false);
  const [tab, setTab] = useState("today");
  const [viewKey, setViewKey] = useState(todayKey());
  const [toasts, setToasts] = useState([]);
  const [levelUp, setLevelUp] = useState(null);
  const [editTask, setEditTask] = useState(null);
  const [editHabit, setEditHabit] = useState(null);
  const [editGoal, setEditGoal] = useState(null);
  const [logGoalFor, setLogGoalFor] = useState(null);
  const prevLevel = useRef(null);

  useEffect(() => {
    let live = true;
    loadState().then((s) => {
      if (!live) return;
      if (s) setState(s);
      setReady(true);
    });
    return () => { live = false; };
  }, []);

  useEffect(() => {
    if (!ready) return;
    const t = setTimeout(() => saveState(state), 350);
    return () => clearTimeout(t);
  }, [state, ready]);

  const C = THEMES[state.theme];
  const ledger = useMemo(() => buildLedger(state), [state]);
  const lvl = levelFromXp(ledger.totalXp);
  const today = todayKey();

  // Celebrate new achievements and level-ups.
  useEffect(() => {
    if (!ready) return;
    const fresh = ledger.unlockedIds.filter((id) => !state.seen.includes(id));
    if (fresh.length) {
      const items = fresh.map((id) => ACHIEVEMENTS.find((a) => a.id === id)).filter(Boolean);
      setToasts((t) => [...t, ...items.map((a) => ({ key: uid(), ach: a }))]);
      setState((s) => ({ ...s, seen: [...s.seen, ...fresh] }));
    }
    if (prevLevel.current !== null && lvl.level > prevLevel.current) setLevelUp(lvl.level);
    prevLevel.current = lvl.level;
  }, [ledger.unlockedIds.join(","), lvl.level, ready]);

  useEffect(() => {
    if (!toasts.length) return;
    const t = setTimeout(() => setToasts((x) => x.slice(1)), 3200);
    return () => clearTimeout(t);
  }, [toasts]);

  /* ------------------------------- actions ------------------------------- */

  const patchDay = useCallback((key, fn) => {
    setState((s) => {
      const cur = s.log[key] || { planned: coreCount(s.schedule, key), tasks: {}, habits: {}, goals: {}, note: "" };
      const next = fn({ ...cur, tasks: { ...cur.tasks }, habits: { ...cur.habits }, goals: { ...(cur.goals || {}) } }, s);
      return { ...s, log: { ...s.log, [key]: next } };
    });
  }, []);

  const toggleTask = (key, task) => {
    patchDay(key, (day) => {
      if (day.tasks[task.id]) { delete day.tasks[task.id]; return day; }
      day.tasks[task.id] = {
        t: new Date().toISOString(),
        xp: DIFFICULTY[task.difficulty],
        min: durationOf(task),
        cat: task.category, start: task.anytime ? null : task.start, opt: !!task.optional,
      };
      return day;
    });
  };

  const toggleHabit = (key, habit) => {
    patchDay(key, (day) => {
      if (day.habits[habit.id]) { delete day.habits[habit.id]; return day; }
      day.habits[habit.id] = {
        t: new Date().toISOString(), xp: DIFFICULTY[habit.difficulty], cat: habit.category,
      };
      return day;
    });
  };

  const logGoal = (key, goal, minutes) => {
    patchDay(key, (day) => {
      if (day.goals[goal.id]) { delete day.goals[goal.id]; return day; }
      const min = minutes || 0;
      day.goals[goal.id] = {
        t: new Date().toISOString(), xp: DIFFICULTY[goal.difficulty], min,
        cat: goal.category, ok: min >= (goal.minMinutes || 0),
      };
      return day;
    });
    setLogGoalFor(null);
  };
  const saveGoal = (g) => {
    setState((s) => {
      const list = s.goals || [];
      const exists = list.some((x) => x.id === g.id);
      return { ...s, goals: exists ? list.map((x) => (x.id === g.id ? g : x)) : [...list, g] };
    });
    setEditGoal(null);
  };
  const deleteGoal = (id) => {
    setState((s) => ({ ...s, goals: (s.goals || []).filter((x) => x.id !== id) }));
    setEditGoal(null);
  };

  const saveTask = (task) => {
    setState((s) => {
      const exists = s.schedule.some((t) => t.id === task.id);
      return {
        ...s, sampleData: false,
        schedule: exists ? s.schedule.map((t) => (t.id === task.id ? task : t)) : [...s.schedule, task],
      };
    });
    setEditTask(null);
  };
  const deleteTask = (id) => {
    setState((s) => ({ ...s, schedule: s.schedule.filter((t) => t.id !== id) }));
    setEditTask(null);
  };
  const saveHabit = (h) => {
    setState((s) => {
      const exists = s.habits.some((x) => x.id === h.id);
      return { ...s, habits: exists ? s.habits.map((x) => (x.id === h.id ? h : x)) : [...s.habits, h] };
    });
    setEditHabit(null);
  };
  const deleteHabit = (id) => {
    setState((s) => ({ ...s, habits: s.habits.filter((x) => x.id !== id) }));
    setEditHabit(null);
  };
  const useFreeze = (key) => setState((s) => ({ ...s, freezes: { ...s.freezes, [key]: true } }));
  const toggleTheme = () => setState((s) => ({ ...s, theme: s.theme === "dark" ? "light" : "dark" }));

  if (!ready) {
    return (
      <div style={{ background: C.bg, minHeight: "100vh", display: "grid", placeItems: "center", color: C.dim }}>
        <div style={{ fontSize: 13 }}>Loading your log…</div>
      </div>
    );
  }

  const TABS = [
    { id: "today", label: "Today", Icon: ListChecks },
    { id: "habits", label: "Routine", Icon: Repeat },
    { id: "stats", label: "Stats", Icon: BarChart3 },
    { id: "awards", label: "Awards", Icon: Trophy },
    { id: "review", label: "Review", Icon: Target },
  ];

  return (
    <div style={{ background: C.bg, minHeight: "100vh", color: C.text, fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" }}>
      <Styles />
      <div style={{ maxWidth: 560, margin: "0 auto", padding: "0 14px 108px" }}>
        <Header C={C} lvl={lvl} totalXp={ledger.totalXp} streak={ledger.stats.streak}
          theme={state.theme} onTheme={toggleTheme} />

        {tab === "today" && (
          <TodayScreen
            C={C} state={state} ledger={ledger} viewKey={viewKey} setViewKey={setViewKey}
            onToggle={toggleTask} onEdit={setEditTask} onAdd={() => setEditTask(newTask())}
            onFreeze={useFreeze} onToggleHabit={toggleHabit}
            onGoal={(g) => (g.minMinutes > 0 && !(state.log[todayKey()] || {}).goals?.[g.id]
              ? setLogGoalFor(g) : logGoal(todayKey(), g, g.minMinutes || 0))}
          />
        )}
        {tab === "habits" && (
          <HabitsScreen C={C} state={state} ledger={ledger} onToggle={toggleHabit}
            onEdit={setEditHabit} onAdd={() => setEditHabit(newHabit())}
            onEditGoal={setEditGoal} onAddGoal={() => setEditGoal(newGoal())}
            onGoal={(g) => (g.minMinutes > 0 && !(state.log[todayKey()] || {}).goals?.[g.id]
              ? setLogGoalFor(g) : logGoal(todayKey(), g, g.minMinutes || 0))} />
        )}
        {tab === "stats" && <StatsScreen C={C} state={state} ledger={ledger} lvl={lvl} />}
        {tab === "awards" && <AwardsScreen C={C} ledger={ledger} />}
        {tab === "review" && <ReviewScreen C={C} state={state} ledger={ledger} setState={setState} />}
      </div>

      <nav style={{
        position: "fixed", left: 0, right: 0, bottom: 0, zIndex: 40,
        background: state.theme === "dark" ? "rgba(16,20,29,.92)" : "rgba(255,255,255,.94)",
        borderTop: `1px solid ${C.line}`, backdropFilter: "blur(14px)",
      }}>
        <div style={{ maxWidth: 560, margin: "0 auto", display: "grid", gridTemplateColumns: "repeat(5,1fr)" }}>
          {TABS.map(({ id, label, Icon }) => {
            const on = tab === id;
            return (
              <button key={id} onClick={() => { setTab(id); if (id === "today") setViewKey(today); }}
                style={{
                  background: "none", border: "none", cursor: "pointer", padding: "11px 0 15px",
                  color: on ? C.text : C.faint, display: "flex", flexDirection: "column",
                  alignItems: "center", gap: 4,
                }}>
                <Icon size={19} strokeWidth={on ? 2.4 : 1.9} />
                <span style={{ fontSize: 10.5, fontWeight: on ? 700 : 500 }}>{label}</span>
              </button>
            );
          })}
        </div>
      </nav>

      <TaskSheet task={editTask} C={C} onSave={saveTask} onDelete={deleteTask} onClose={() => setEditTask(null)} />
      <HabitSheet habit={editHabit} C={C} onSave={saveHabit} onDelete={deleteHabit} onClose={() => setEditHabit(null)} />
      <GoalSheet goal={editGoal} C={C} onSave={saveGoal} onDelete={deleteGoal} onClose={() => setEditGoal(null)} />
      <GoalLogSheet goal={logGoalFor} C={C} onClose={() => setLogGoalFor(null)}
        onLog={(mins) => logGoal(todayKey(), logGoalFor, mins)} />
      <Toasts toasts={toasts} C={C} />
      {levelUp && <LevelUp level={levelUp} C={C} onClose={() => setLevelUp(null)} />}
    </div>
  );
}

const newTask = () => ({
  id: uid(), name: "", start: "17:00", end: "17:30", anytime: false, minutes: 30,
  category: "Revision", difficulty: "medium", must: false, optional: false, days: [0, 1, 2, 3, 4],
});
const newHabit = () => ({
  id: uid(), name: "", category: "Recovery", difficulty: "easy", days: [0, 1, 2, 3, 4, 5, 6],
});
const newGoal = () => ({
  id: uid(), name: "", category: "Training", difficulty: "medium", target: 3, minMinutes: 0,
});

/* --------------------------------- header -------------------------------- */

function Header({ C, lvl, totalXp, streak, theme, onTheme }) {
  return (
    <header style={{ paddingTop: 18, paddingBottom: 14 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 12 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 11 }}>
          <div style={{
            width: 42, height: 42, borderRadius: 12, display: "grid", placeItems: "center",
            background: `linear-gradient(150deg, ${ICE}, #3B7BD6)`, color: "#08121F",
            fontFamily: "Archivo, Inter, sans-serif", fontWeight: 800, fontSize: 17,
          }}>{lvl.level}</div>
          <div>
            <div className="apex-num" style={{ fontSize: 17, letterSpacing: "-.02em" }}>{rankFor(lvl.level)}</div>
            <div style={{ fontSize: 11.5, color: C.dim }}>
              {totalXp.toLocaleString()} XP · {lvl.level >= 100 ? "maxed" : `${(lvl.need - lvl.into).toLocaleString()} to level ${lvl.level + 1}`}
            </div>
          </div>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <div style={{
            display: "flex", alignItems: "center", gap: 5, background: C.panel,
            border: `1px solid ${streak > 0 ? EMBER : C.line}`, borderRadius: 99, padding: "6px 11px",
          }}>
            <Flame size={15} color={streak > 0 ? EMBER : C.faint} fill={streak > 0 ? EMBER : "none"} />
            <span className="apex-num" style={{ fontSize: 15, color: streak > 0 ? C.text : C.faint }}>{streak}</span>
          </div>
          <button onClick={onTheme} aria-label="Switch theme" style={{
            background: C.panel, border: `1px solid ${C.line}`, color: C.dim,
            borderRadius: 99, padding: 8, cursor: "pointer", display: "grid", placeItems: "center",
          }}>
            {theme === "dark" ? <Sun size={15} /> : <Moon size={15} />}
          </button>
        </div>
      </div>
      <Bar pct={lvl.pct} color={`linear-gradient(90deg, ${XP_C}, #FF8A3D)`} track={C.panel2} height={7} />
    </header>
  );
}

/* --------------------------------- today --------------------------------- */

function TodayScreen({ C, state, ledger, viewKey, setViewKey, onToggle, onEdit, onAdd, onFreeze, onToggleHabit, onGoal }) {
  const today = todayKey();
  const isToday = viewKey === today;
  const isFuture = parseKey(viewKey) > parseKey(today);
  const tasks = tasksForDate(state.schedule, viewKey);
  const habits = habitsForDate(state.habits, viewKey);
  const day = state.log[viewKey] || { tasks: {}, habits: {} };
  const core = tasks.filter((t) => !t.optional);
  const doneCount = core.filter((t) => day.tasks && day.tasks[t.id]).length;
  const extraDone = tasks.filter((t) => t.optional && day.tasks && day.tasks[t.id]).length;
  const pct = core.length ? (doneCount / core.length) * 100 : 0;

  const [now, setNow] = useState(() => new Date());
  useEffect(() => { const i = setInterval(() => setNow(new Date()), 60000); return () => clearInterval(i); }, []);
  const nowMin = now.getHours() * 60 + now.getMinutes();

  const timed = tasks.filter((t) => !t.anytime);
  const floating = tasks.filter((t) => t.anytime);
  const first = timed.length ? toMin(timed[0].start) : 0;
  const last = timed.length ? Math.max(...timed.map((t) => toMin(t.end))) : 1;
  const span = Math.max(60, last - first);

  const yesterday = shiftKey(today, -1);
  const yDay = ledger.days.find((d) => d.key === yesterday);
  const canFreeze = isToday && yDay && !yDay.qualified && !yDay.neutral && !yDay.frozen && ledger.stats.freezesAvailable > 0;

  return (
    <div>
      {/* date rail */}
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 12 }}>
        <button onClick={() => setViewKey(shiftKey(viewKey, -1))} style={navBtn(C)} aria-label="Previous day">
          <ChevronLeft size={17} />
        </button>
        <div style={{ textAlign: "center" }}>
          <div className="apex-num" style={{ fontSize: 19, letterSpacing: "-.02em" }}>
            {isToday ? "Today" : prettyDate(viewKey).split(",")[0]}
          </div>
          <div style={{ fontSize: 11.5, color: C.dim }}>{prettyDate(viewKey)}</div>
        </div>
        <button onClick={() => setViewKey(shiftKey(viewKey, 1))} style={navBtn(C)} aria-label="Next day">
          <ChevronRight size={17} />
        </button>
      </div>

      {/* the day track — the one bold element */}
      <div style={{
        background: C.panel, border: `1px solid ${C.line}`, borderRadius: 18,
        padding: "16px 16px 14px", marginBottom: 14, boxShadow: C.shadow,
      }}>
        <div style={{ display: "flex", alignItems: "baseline", justifyContent: "space-between", marginBottom: 12 }}>
          <div>
            {core.length === 0 ? (
              <span className="apex-num" style={{ fontSize: 32, letterSpacing: "-.03em" }}>Rest day</span>
            ) : (<>
              <span className="apex-num" style={{ fontSize: 38, letterSpacing: "-.03em" }}>{Math.round(pct)}</span>
              <span className="apex-num" style={{ fontSize: 19, color: C.dim }}>%</span>
            </>)}
            <span style={{ fontSize: 12.5, color: C.dim, marginLeft: 9 }}>
              {core.length === 0 ? "nothing required" : `${doneCount} of ${core.length} done`}
              {extraDone > 0 && <span style={{ color: ICE }}> · +{extraDone} extra</span>}
            </span>
          </div>
          {timed.length > 0 ? (
            <div style={{ fontSize: 11.5, color: C.faint }}>{timed[0].start}–{timed[timed.length - 1].end}</div>
          ) : floating.length > 0 ? (
            <div style={{ fontSize: 11.5, color: C.faint }}>
              {Math.floor(floating.reduce((a, t) => a + durationOf(t), 0) / 60)}h to place
            </div>
          ) : null}
        </div>

        <div style={{ position: "relative", height: timed.length ? 26 : 0, display: timed.length ? "block" : "none" }}>
          <div style={{ position: "absolute", top: 11, left: 0, right: 0, height: 3, background: C.panel2, borderRadius: 2 }} />
          {timed.map((t) => {
            const l = ((toMin(t.start) - first) / span) * 100;
            const w = Math.max(2.5, ((toMin(t.end) - toMin(t.start)) / span) * 100);
            const done = !!day.tasks[t.id];
            return (
              <div key={t.id} title={`${t.name} · ${t.start}`} style={{
                position: "absolute", left: `${l}%`, width: `${w}%`, top: 5, height: 15,
                background: done ? CATEGORIES[t.category] : "transparent",
                border: `1.5px ${t.optional && !done ? "dashed" : "solid"} ${done ? CATEGORIES[t.category] : C.line}`,
                borderRadius: 5, transition: "background .35s ease",
                opacity: t.optional && !done ? .6 : 1,
              }} />
            );
          })}
          {isToday && timed.length > 0 && nowMin >= first && nowMin <= last && (
            <div style={{
              position: "absolute", left: `${((nowMin - first) / span) * 100}%`, top: 0,
              width: 2, height: 26, background: C.text, borderRadius: 2, opacity: .75,
            }} />
          )}
        </div>

        {timed.length === 0 && floating.length > 0 && (
          <div style={{ display: "flex", gap: 5 }}>
            {floating.map((t) => {
              const done = !!day.tasks[t.id];
              return (
                <div key={t.id} title={t.name} style={{
                  flex: durationOf(t), height: 15, borderRadius: 5,
                  background: done ? CATEGORIES[t.category] : "transparent",
                  border: `1.5px ${t.optional && !done ? "dashed" : "solid"} ${done ? CATEGORIES[t.category] : C.line}`,
                  transition: "background .35s ease",
                }} />
              );
            })}
          </div>
        )}
      </div>

      {canFreeze && (
        <button onClick={() => onFreeze(yesterday)} style={{
          width: "100%", background: C.panel, border: `1px solid ${ICE}`, borderRadius: 14,
          padding: "12px 14px", color: C.text, cursor: "pointer", marginBottom: 14,
          display: "flex", alignItems: "center", gap: 10, textAlign: "left",
        }}>
          <Snowflake size={17} color={ICE} />
          <div>
            <div style={{ fontSize: 13.5, fontWeight: 600 }}>Save yesterday's streak</div>
            <div style={{ fontSize: 11.5, color: C.dim }}>
              {ledger.stats.freezesAvailable} freeze{ledger.stats.freezesAvailable === 1 ? "" : "s"} banked
            </div>
          </div>
        </button>
      )}

      {state.sampleData && (
        <div style={{
          background: C.panel2, border: `1px dashed ${C.line}`, borderRadius: 12,
          padding: "11px 13px", marginBottom: 14, fontSize: 12.5, color: C.dim,
        }}>
          These three sessions are placeholders. Add your own and they'll disappear.
        </div>
      )}

      {tasks.length === 0 ? (
        <Empty C={C} title="Nothing scheduled" body={`No sessions set for ${DOW[dowOf(viewKey)]}. Add one and it repeats every week.`} onAdd={onAdd} />
      ) : (
        <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
          {tasks.map((t) => (
            <TaskRow key={t.id} t={t} C={C} done={!!day.tasks[t.id]} locked={isFuture}
              onToggle={() => onToggle(viewKey, t)} onEdit={() => onEdit(t)} />
          ))}
        </div>
      )}

      {habits.length > 0 && (
        <>
          <SectionTitle C={C}>Habits</SectionTitle>
          <div style={{ display: "flex", flexWrap: "wrap", gap: 8 }}>
            {habits.map((h) => {
              const done = !!(day.habits && day.habits[h.id]);
              return (
                <button key={h.id} disabled={isFuture} onClick={() => onToggleHabit(viewKey, h)} style={{
                  background: done ? CATEGORIES[h.category] : C.panel,
                  color: done ? "#0F1420" : C.text,
                  border: `1px solid ${done ? CATEGORIES[h.category] : C.line}`,
                  borderRadius: 99, padding: "8px 14px", fontSize: 13, fontWeight: 600,
                  cursor: isFuture ? "default" : "pointer", opacity: isFuture ? .5 : 1,
                  display: "flex", alignItems: "center", gap: 7,
                }}>
                  {done && <Check size={14} strokeWidth={3} />}{h.name}
                </button>
              );
            })}
          </div>
        </>
      )}

      {isToday && (state.goals || []).length > 0 && (
        <>
          <SectionTitle C={C}>This week</SectionTitle>
          <GoalStrip C={C} state={state} dayKey={viewKey} onGoal={onGoal} compact />
        </>
      )}

      <button onClick={onAdd} style={{
        marginTop: 18, width: "100%", background: "none", border: `1px dashed ${C.line}`,
        borderRadius: 14, padding: "13px", color: C.dim, cursor: "pointer",
        display: "flex", alignItems: "center", justifyContent: "center", gap: 8, fontSize: 13.5,
      }}>
        <Plus size={16} /> Add a session
      </button>
    </div>
  );
}

const navBtn = (C) => ({
  background: C.panel, border: `1px solid ${C.line}`, color: C.dim,
  borderRadius: 11, padding: 9, cursor: "pointer", display: "grid", placeItems: "center",
});

function GoalStrip({ C, state, dayKey, onGoal, compact }) {
  const goals = state.goals || [];
  if (!goals.length) return null;
  const counts = weekGoalCounts(state, dayKey);
  const today = todayKey();
  const entry = state.log[today] || {};
  const wsLabel = weekStartOf(dayKey);

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
      {goals.map((g) => {
        const n = counts[g.id] || 0;
        const met = n >= g.target;
        const loggedToday = !!(entry.goals && entry.goals[g.id]);
        const col = CATEGORIES[g.category];
        return (
          <div key={g.id} style={{
            background: C.panel, border: `1px solid ${met ? col + "66" : C.line}`,
            borderRadius: 14, padding: "11px 13px", display: "flex", alignItems: "center", gap: 12,
          }}>
            <button onClick={() => onGoal(g)} aria-label={`Log ${g.name}`} style={{
              width: 25, height: 25, borderRadius: 8, flexShrink: 0, display: "grid", placeItems: "center",
              background: loggedToday ? col : "transparent",
              border: `2px solid ${loggedToday ? col : C.line}`, color: "#0F1420", cursor: "pointer",
            }}>{loggedToday && <Check size={15} strokeWidth={3.4} />}</button>
            <div style={{ flex: 1, minWidth: 0 }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", gap: 8 }}>
                <span style={{ fontSize: 14, fontWeight: 600, color: met ? C.text : C.text }}>{g.name}</span>
                <span className="apex-num" style={{ fontSize: 13, color: met ? col : C.dim }}>
                  {n}/{g.target}
                </span>
              </div>
              <div style={{ display: "flex", gap: 3, marginTop: 7 }}>
                {Array.from({ length: g.target }, (_, i) => (
                  <div key={i} style={{
                    flex: 1, height: 5, borderRadius: 3,
                    background: i < n ? col : C.panel2,
                    border: i < n ? "none" : `1px solid ${C.line}`,
                  }} />
                ))}
              </div>
              {!compact && (
                <div style={{ fontSize: 11, color: C.faint, marginTop: 5 }}>
                  {g.minMinutes > 0 ? `${g.minMinutes} min minimum · ` : ""}
                  {met ? "target met" : `${g.target - n} to go this week`}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}

function SectionTitle({ children, C }) {
  return <h3 className="apex-num" style={{ fontSize: 15, color: C.text, margin: "22px 0 10px", letterSpacing: "-.01em" }}>{children}</h3>;
}

function Empty({ C, title, body, onAdd }) {
  return (
    <div style={{ background: C.panel, border: `1px solid ${C.line}`, borderRadius: 16, padding: 26, textAlign: "center" }}>
      <div className="apex-num" style={{ fontSize: 17, marginBottom: 6 }}>{title}</div>
      <div style={{ fontSize: 13, color: C.dim, marginBottom: 16, lineHeight: 1.5 }}>{body}</div>
      {onAdd && (
        <button onClick={onAdd} style={{
          background: XP_C, color: "#1A1206", border: "none", borderRadius: 11,
          padding: "10px 18px", fontWeight: 700, fontSize: 13.5, cursor: "pointer",
        }}>Add a session</button>
      )}
    </div>
  );
}

