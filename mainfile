        </div>
      </Field>
      <div style={{ fontSize: 12, color: C.faint, marginBottom: 16, lineHeight: 1.5 }}>
        Hitting the target pays a {GOAL_BONUS} XP bonus. Meeting every goal in one week pays {ALL_GOALS_BONUS}.
      </div>
      <div style={{ display: "flex", gap: 9 }}>
        {goal && goal.name && (
          <button onClick={() => onDelete(d.id)} style={{
            background: C.panel2, border: `1px solid ${C.line}`, color: EMBER,
            borderRadius: 11, padding: "12px 15px", cursor: "pointer",
          }}><Trash2 size={16} /></button>
        )}
        <button disabled={!valid} onClick={() => onSave({ ...d, name: d.name.trim() })} style={{
          flex: 1, background: valid ? XP_C : C.panel2, color: valid ? "#1A1206" : C.faint,
          border: "none", borderRadius: 11, padding: 13, fontWeight: 700, fontSize: 14,
          cursor: valid ? "pointer" : "default",
        }}>Save goal</button>
      </div>
    </Sheet>
  );
}

/* ------------------------------ celebrations ----------------------------- */

function Toasts({ toasts, C }) {
  if (!toasts.length) return null;
  return (
    <div style={{
      position: "fixed", left: 0, right: 0, bottom: 84, zIndex: 70,
      display: "flex", flexDirection: "column", alignItems: "center", gap: 8, pointerEvents: "none",
    }}>
      {toasts.slice(0, 3).map((t) => {
        const col = RARITY_C[t.ach.rarity];
        return (
          <div key={t.key} className="apex-toast" style={{
            background: C.panel, border: `1px solid ${col}`, borderRadius: 14,
            padding: "11px 15px", display: "flex", alignItems: "center", gap: 11,
            boxShadow: C.shadow, maxWidth: 400, width: "90%",
          }}>
            <div style={{ width: 32, height: 32, borderRadius: 10, background: col, display: "grid", placeItems: "center", color: "#0F1420", flexShrink: 0 }}>
              <Trophy size={16} />
            </div>
            <div style={{ flex: 1, minWidth: 0 }}>
              <div style={{ fontSize: 13.5, fontWeight: 650, color: C.text }}>{t.ach.name}</div>
              <div style={{ fontSize: 11.5, color: C.dim }}>{t.ach.desc}</div>
            </div>
            <span className="apex-num" style={{ color: XP_C, fontSize: 13 }}>+{t.ach.xp}</span>
          </div>
        );
      })}
    </div>
  );
}

