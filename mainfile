  return (
    <div style={{
      display: "flex", alignItems: "stretch", background: C.panel,
      border: `1px solid ${done ? col + "66" : C.line}`, borderRadius: 14, overflow: "hidden",
      opacity: locked ? .55 : 1, transition: "border-color .3s ease",
    }}>
      <div style={{ width: 4, background: col, flexShrink: 0 }} />
      <button disabled={locked} onClick={onToggle} style={{
        flex: 1, background: "none", border: "none", cursor: locked ? "default" : "pointer",
