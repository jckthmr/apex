        </div>
      </Field>
      <Field label="Effort" C={C}>
        <div style={{ display: "flex", gap: 6 }}>
          {DIFF_KEYS.map((k) => (
            <Chip key={k} active={d.difficulty === k} color={XP_C} onClick={() => set("difficulty", k)} C={C} small>
